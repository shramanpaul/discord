# Example environment variables for local development / docker
# Copy this file to `.env` and fill in real values before running.

# Database (MySQL)
DATABASE_URL="mysql://discord_user:discord_pass@localhost:3306/discord"
MYSQL_ROOT_PASSWORD=example_root_password

# App
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Third-party placeholders (replace with real credentials if used)
CLERK_FRONTEND_API=your_clerk_frontend_api
UPLOADTHING_SECRET=your_uploadthing_secret
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_secret
